# Runna Frontend Environment Variables

# Mock 데이터 사용 여부
# - true: 로컬 개발 시 Mock 데이터 사용
# - false: 실제 Backend API 사용
VITE_USE_MOCK_DATA=true

# Backend API URL
# - 개발: http://localhost:8000
# - Staging: https://api-staging.runna.dev
# - Production: https://api.runna.dev
VITE_API_URL=http://localhost:8000
